<ui:FluentWindow x:Class="MailDirector.Views.CreateRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:MailDirector.ViewModels"
        Title="Create / Update Rule"
        Width="500" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Rule Assistant"/>

        <TextBlock Grid.Row="1" Text="Configure Email Rule"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,8,0,16"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton Content="Create New Rule" IsChecked="{Binding IsCreatingNew, Mode=TwoWay}"
                             GroupName="RuleMode" Margin="0,0,16,0"/>
                <RadioButton Content="Add Sender to Existing Rule" IsChecked="{Binding IsCreatingNew, Mode=TwoWay, Converter={StaticResource InverseBoolToVis}}"
                             GroupName="RuleMode"/>
            </StackPanel>

            <!-- Mode 1: Create New Rule -->
            <StackPanel Visibility="{Binding IsCreatingNew, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Rule Name" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Enter rule name..." Margin="0,0,0,12"/>

                <TextBlock Text="Sender to Match" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBox Text="{Binding SenderEmail, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,12"/>

                <TextBlock Text="Move Matching Emails to Folder" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="e.g. Archive, Projects\MailDirector" Margin="0,0,0,12"/>

                <CheckBox Content="Mark as read automatically" IsChecked="{Binding MarkAsRead, Mode=TwoWay}" Margin="0,0,0,12"/>

                <TextBlock Text="Tag Color" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <ui:Button Content="Blue" Background="#0052CC" Foreground="White" Margin="0,0,6,0"
                               Click="OnSelectColor" Tag="#0052CC"/>
                    <ui:Button Content="Green" Background="#2EA44F" Foreground="White" Margin="0,0,6,0"
                               Click="OnSelectColor" Tag="#2EA44F"/>
                    <ui:Button Content="Red" Background="#D9534F" Foreground="White" Margin="0,0,6,0"
                               Click="OnSelectColor" Tag="#D9534F"/>
                    <ui:Button Content="Orange" Background="#F97316" Foreground="White" Margin="0,0,6,0"
                               Click="OnSelectColor" Tag="#F97316"/>
                    <ui:Button Content="Purple" Background="#8B5CF6" Foreground="White" Margin="0,0,6,0"
                               Click="OnSelectColor" Tag="#8B5CF6"/>
                </StackPanel>
            </StackPanel>

            <!-- Mode 2: Add Sender to Existing Rule -->
            <StackPanel Visibility="{Binding IsCreatingNew, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Select Existing Rule" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ComboBox ItemsSource="{Binding ExistingRules}"
                          SelectedItem="{Binding SelectedExistingRule, Mode=TwoWay}"
                          DisplayMemberPath="Name" Margin="0,0,0,12"/>

                <TextBlock Text="Sender Address" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBox Text="{Binding SenderEmail, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,12"/>

                <TextBlock Text="This sender address will be added to the selected rule's criteria list."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="OnCancelClick"/>
            <ui:Button Content="Save Rule" Appearance="Primary" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
