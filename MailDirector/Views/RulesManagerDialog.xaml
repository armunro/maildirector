<ui:FluentWindow x:Class="MailDirector.Views.RulesManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:MailDirector.Models"
        xmlns:viewModels="clr-namespace:MailDirector.ViewModels"
        Title="Email Rules Manager"
        Width="880" Height="620"
        MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Email Rules Manager"/>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: Rule List -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ui:Button Grid.Row="0"
                               Content="Create New Rule"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Symbol=Add24}"
                               Command="{Binding NewRuleCommand}"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,12"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Rules}"
                             SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FilterRule}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             Fill="{Binding Color, Converter={StaticResource HexColorBrush}}"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right column: Rule Editor -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Edit Filter Rule"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- Rule Name & Color -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rule Name" FontWeight="Medium" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Enter rule name..."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Color Badge" FontWeight="Medium" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Background="#0052CC" Width="26" Height="26" Margin="0,0,4,0"
                                               Click="OnColorSwatchClick" Tag="#0052CC"/>
                                    <ui:Button Background="#2EA44F" Width="26" Height="26" Margin="0,0,4,0"
                                               Click="OnColorSwatchClick" Tag="#2EA44F"/>
                                    <ui:Button Background="#D9534F" Width="26" Height="26" Margin="0,0,4,0"
                                               Click="OnColorSwatchClick" Tag="#D9534F"/>
                                    <ui:Button Background="#F97316" Width="26" Height="26" Margin="0,0,4,0"
                                               Click="OnColorSwatchClick" Tag="#F97316"/>
                                    <ui:Button Background="#8B5CF6" Width="26" Height="26" Margin="0,0,4,0"
                                               Click="OnColorSwatchClick" Tag="#8B5CF6"/>
                                    <ui:Button Background="#06B6D4" Width="26" Height="26" Margin="0,0,4,0"
                                               Click="OnColorSwatchClick" Tag="#06B6D4"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Conditions Section -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Criteria (matches any criterion)"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ui:Button Content="+ Add Criterion"
                                               Appearance="Secondary"
                                               Command="{Binding AddFilterCommand}"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Filters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:FilterCriteriaViewModel}">
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                                        <TextBlock Text="From (comma-separated senders or domains):"
                                                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <ui:TextBox Text="{Binding FromString, UpdateSourceTrigger=PropertyChanged}"
                                                                    PlaceholderText="e.g. jira@atlassian.net, github.com"/>
                                                    </StackPanel>

                                                    <ui:Button Grid.Row="0" Grid.Column="1"
                                                               Appearance="Transparent"
                                                               Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                               Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                               CommandParameter="{Binding}"
                                                               VerticalAlignment="Top"
                                                               ToolTip="Remove criterion"/>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                                                        <TextBlock Text="Subject Contains (comma-separated words):"
                                                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <ui:TextBox Text="{Binding SubjectContainsString, UpdateSourceTrigger=PropertyChanged}"
                                                                    PlaceholderText="e.g. [JIRA], Alert, Weekly Report"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                                        <TextBlock Text="Body Contains (comma-separated words):"
                                                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <ui:TextBox Text="{Binding BodyContainsString, UpdateSourceTrigger=PropertyChanged}"
                                                                    PlaceholderText="e.g. urgent, invoice, action required"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Actions Section -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Actions (executed on match)"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ui:Button Content="+ Add Action"
                                               Appearance="Secondary"
                                               Command="{Binding AddActionCommand}"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Actions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:RuleActionViewModel}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableActionTypes}"
                                                          SelectedItem="{Binding Type, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource ActionTypeToString}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <ui:TextBox Grid.Column="2"
                                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="{Binding ValuePlaceholder}"
                                                            IsEnabled="{Binding RequiresValue}"/>

                                                <ui:Button Grid.Column="4"
                                                           Appearance="Transparent"
                                                           Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                           Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Remove action"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Buttons & Status -->
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Duplicate"
                                           Appearance="Secondary"
                                           Command="{Binding DuplicateRuleCommand}"
                                           Margin="0,0,8,0"/>
                                <ui:Button Content="Delete Rule"
                                           Appearance="Danger"
                                           Command="{Binding DeleteRuleCommand}"
                                           Margin="0,0,8,0"/>
                                <ui:Button Content="Save Rule"
                                           Appearance="Primary"
                                           Command="{Binding SaveRuleCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Padding="0,12,0,0">
            <ui:Button Content="Close" Appearance="Secondary" HorizontalAlignment="Right" Click="OnCloseClick"/>
        </Border>
    </Grid>
</ui:FluentWindow>
