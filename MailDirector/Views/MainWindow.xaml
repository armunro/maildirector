<ui:FluentWindow x:Class="MailDirector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:MailDirector.Models"
        xmlns:viewModels="clr-namespace:MailDirector.ViewModels"
        Title="MailDirector"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding OpenRulesManagerCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="MailDirector"/>

        <!-- Top Header & Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Badge & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            CornerRadius="8"
                            Margin="0,0,12,0">
                        <TextBlock Text="FM"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MailDirector"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Box -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="480">
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search emails by subject, sender, or text..."
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                ClearButtonEnabled="True"/>
                </Grid>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Refresh Button with Spinner -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Margin="0,0,8,0"
                               ToolTip="Refresh (F5)">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl ContentTemplate="{StaticResource RefreshSpinnerTemplate}"
                                            Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,6,0"/>
                            <ui:SymbolIcon Symbol="ArrowClockwise24"
                                           Visibility="{Binding IsRefreshing, Converter={StaticResource InverseBoolToVis}}"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Rules Manager -->
                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon Symbol=Filter24}"
                               Content="Rules Manager"
                               Command="{Binding OpenRulesManagerCommand}"
                               Margin="0,0,8,0"
                               ToolTip="Manage Email Rules (Ctrl+R)"/>

                    <!-- Layout Options -->
                    <Menu Background="Transparent" Margin="0,0,8,0" VerticalAlignment="Center">
                        <MenuItem Header="Layout" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <MenuItem Header="Reading Pane Right" Command="{Binding SetLayoutCommand}" CommandParameter="Right"/>
                            <MenuItem Header="Reading Pane Bottom" Command="{Binding SetLayoutCommand}" CommandParameter="Bottom"/>
                            <MenuItem Header="Reading Pane Hidden" Command="{Binding SetLayoutCommand}" CommandParameter="Off"/>
                        </MenuItem>
                    </Menu>

                    <!-- Settings -->
                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon Symbol=Settings24}"
                               Command="{Binding OpenSettingsCommand}"
                               ToolTip="Settings (Ctrl+,)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace: Sidebar + Email List + Reading Pane -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Folders Sidebar -->
                <ColumnDefinition Width="240" MinWidth="160" MaxWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Email List + Reading Pane Split -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Folders -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Folders"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>

                            <ui:Button HorizontalAlignment="Right"
                                       Appearance="Transparent"
                                       Icon="{ui:SymbolIcon Symbol=Edit24}"
                                       Command="{Binding ToggleFolderEditModeCommand}"
                                       ToolTip="Customize Folders (Rename, Reorder, Color, Hide)"/>
                        </Grid>
                    </Border>

                    <!-- Folders List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Folders}"
                             SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FolderListItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MailFolderItem}">
                                <Border Margin="{Binding Level, Converter={StaticResource FolderLevelMargin}}">
                                    <Grid Margin="2,3">
                                        <!-- Normal Mode Display -->
                                        <Grid Visibility="{Binding DataContext.IsEditingFolders, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Folder Icon with Custom Color -->
                                            <ui:SymbolIcon Grid.Column="0"
                                                           Symbol="{Binding Converter={StaticResource FolderSymbol}}"
                                                           Foreground="{Binding Color, Converter={StaticResource HexColorBrush}}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>

                                            <!-- Folder Display Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EffectiveDisplayName}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Unread Count Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    CornerRadius="10"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding UnreadItemCount, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding UnreadItemCount}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <!-- Edit Mode Display -->
                                        <Grid Visibility="{Binding DataContext.IsEditingFolders, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- In-place Custom Name Edit -->
                                            <ui:TextBox Grid.Row="0" Grid.Column="0"
                                                        Text="{Binding CustomDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{Binding DisplayName}"
                                                        Margin="0,0,4,4"/>

                                            <!-- Controls: Hide/Show, Move Up/Down -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                <ui:Button Appearance="Transparent"
                                                           Icon="{ui:SymbolIcon Symbol=Eye24}"
                                                           Command="{Binding DataContext.ToggleFolderVisibilityCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Toggle Visibility"
                                                           Margin="0,0,2,0"/>
                                                <ui:Button Appearance="Transparent"
                                                           Icon="{ui:SymbolIcon Symbol=ArrowUp24}"
                                                           Command="{Binding DataContext.MoveFolderUpCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Move Up"
                                                           Margin="0,0,2,0"/>
                                                <ui:Button Appearance="Transparent"
                                                           Icon="{ui:SymbolIcon Symbol=ArrowDown24}"
                                                           Command="{Binding DataContext.MoveFolderDownCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Move Down"/>
                                            </StackPanel>

                                            <!-- Color Swatches Row -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,4">
                                                <TextBlock Text="Color:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Button Width="16" Height="16" Background="#0052CC" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#0052CC"/>
                                                <Button Width="16" Height="16" Background="#2EA44F" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#2EA44F"/>
                                                <Button Width="16" Height="16" Background="#D9534F" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#D9534F"/>
                                                <Button Width="16" Height="16" Background="#F97316" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#F97316"/>
                                                <Button Width="16" Height="16" Background="#8B5CF6" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#8B5CF6"/>
                                                <Button Width="16" Height="16" Background="#06B6D4" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#06B6D4"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

            <!-- MAIN CONTENT: Email List + Reading Pane -->
            <Grid Grid.Column="2">
                <!-- Layout 1: Right Reading Pane -->
                <Grid Visibility="{Binding IsReadingPaneRight, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="350"/>
                    </Grid.ColumnDefinitions>

                    <!-- Email List Column -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Email List Header -->
                        <Border Grid.Row="0" Padding="16,10"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedFolder.EffectiveDisplayName, FallbackValue='Inbox'}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Emails.Count, StringFormat='({0} emails)'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Apply Rule to All Dropdown -->
                                <Menu Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <MenuItem Header="Apply Rule to Folder ▾"
                                              ItemsSource="{Binding Rules}"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:FilterRule}">
                                                <MenuItem Header="{Binding Name}"
                                                          Command="{Binding DataContext.ApplyRuleToAllCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                          CommandParameter="{Binding Name}"/>
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                    </MenuItem>
                                </Menu>
                            </Grid>
                        </Border>

                        <!-- Email Cards List -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Emails}"
                                 SelectedItem="{Binding SelectedEmail, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource EmailListItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:EmailItem}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Unread Indicator Dot -->
                                        <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8"
                                                 Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                 Visibility="{Binding IsRead, Converter={StaticResource InverseBoolToVis}}"
                                                 Margin="0,0,8,0" VerticalAlignment="Center"/>

                                        <!-- Sender Avatar & Name -->
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding From}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Date -->
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding ReceivedDateTime, Converter={StaticResource FriendlyDate}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                        <!-- Subject -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding Subject}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,3"/>

                                        <!-- Preview -->
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding BodyPreview, Converter={StaticResource Truncate}, ConverterParameter=100}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,4"/>

                                        <!-- Matching Rule Badges Ribbon -->
                                        <ItemsControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding MatchingRules}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:MatchingRuleDto}">
                                                    <Border Background="{Binding Color, Converter={StaticResource HexColorBrush}}"
                                                            CornerRadius="4" Padding="6,2" Margin="0,0,4,2">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Splitter 2 -->
                    <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Right Reading Pane Column -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Padding="24,16">
                        <!-- Details View -->
                        <Grid Visibility="{Binding SelectedEmail, Converter={StaticResource NullToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Email Subject & Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding SelectedEmail.Subject}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap"/>

                                <!-- Quick Actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ui:Button Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Symbol=Archive24}"
                                               Command="{Binding ArchiveEmailCommand}"
                                               ToolTip="Archive Email"
                                               Margin="0,0,4,0"/>
                                    <ui:Button Appearance="Danger"
                                               Icon="{ui:SymbolIcon Symbol=Delete24}"
                                               Command="{Binding DeleteEmailCommand}"
                                               ToolTip="Delete Email"
                                               Margin="0,0,4,0"/>
                                    <ui:Button Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Symbol=Open24}"
                                               Command="{Binding OpenInWebCommand}"
                                               ToolTip="Open in Browser"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sender / Meta Row -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Initials Avatar -->
                                    <Border Grid.Column="0" Width="36" Height="36"
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            CornerRadius="18" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding SelectedEmail.From, Converter={StaticResource Initials}}"
                                                   FontWeight="Bold" FontSize="13" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedEmail.From}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedEmail.FromAddress}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SelectedEmail.ReceivedDateTime, Converter={StaticResource FriendlyDate}}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Rule Action Shortcuts -->
                            <Border Grid.Row="2" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="+ Create Rule for Sender"
                                               Appearance="Secondary"
                                               Command="{Binding OpenCreateRuleDialogCommand}"
                                               Margin="0,0,8,0"/>
                                    <ui:Button Content="+ Add to Existing Rule"
                                               Appearance="Secondary"
                                               Command="{Binding OpenAddSenderToRuleDialogCommand}"
                                               Margin="0,0,8,0"/>

                                    <!-- Apply Single Rule Dropdown -->
                                    <Menu Background="Transparent" VerticalAlignment="Center">
                                        <MenuItem Header="Apply Rule ▾"
                                                  ItemsSource="{Binding Rules}"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <MenuItem.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:FilterRule}">
                                                    <MenuItem Header="{Binding Name}"
                                                              Command="{Binding DataContext.ApplyRuleCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                              CommandParameter="{Binding Name}"/>
                                                </DataTemplate>
                                            </MenuItem.ItemTemplate>
                                        </MenuItem>
                                    </Menu>
                                </StackPanel>
                            </Border>

                            <!-- Email Body Viewer -->
                            <Border Grid.Row="3"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SelectedEmail.BodyPreview}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Layout 2: Bottom Reading Pane -->
                <Grid Visibility="{Binding IsReadingPaneBottom, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300" MinHeight="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="200"/>
                    </Grid.RowDefinitions>

                    <!-- Top Email List -->
                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Emails}"
                             SelectedItem="{Binding SelectedEmail, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource EmailListItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12"/>

                    <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Bottom Details -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Padding="24,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedEmail.Subject}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding SelectedEmail.From}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding SelectedEmail.BodyPreview}"
                                           FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Layout 3: Off / Full List Mode -->
                <Grid Visibility="{Binding IsReadingPaneVisible, Converter={StaticResource InverseBoolToVis}}">
                    <ListBox ItemsSource="{Binding Emails}"
                             SelectedItem="{Binding SelectedEmail, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource EmailListItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="16"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status Bar Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Rule Application Progress Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Background="#80000000"
              Visibility="{Binding IsApplyingRule, Converter={StaticResource BoolToVis}}">
            <Border Width="420"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ApplyingRuleName, StringFormat='Applying Rule: {0}'}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <ProgressBar Value="{Binding RuleProgressPercent}" Height="8" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{Binding RuleProgressCurrent, StringFormat='Processing {0}'}"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding RuleProgressPercent, StringFormat='{}{0}%'}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="{Binding RuleProgressSubject}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,16"/>

                    <ui:Button Content="Cancel" Appearance="Secondary"
                               Command="{Binding CancelApplyRuleCommand}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
