<ui:FluentWindow x:Class="MailDirector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:MailDirector.Models"
        xmlns:viewModels="clr-namespace:MailDirector.ViewModels"
        xmlns:helpers="clr-namespace:MailDirector.Helpers"
        Title="MailDirector"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding OpenRulesManagerCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="MailDirector"/>

        <!-- Top Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <!-- Unified Action Menu & Toolbar -->
            <DockPanel LastChildFill="False">
                    <!-- Right Actions: View & Utility -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource TopToolbarButtonStyle}"
                                   Command="{Binding OpenRulesManagerCommand}"
                                   ToolTip="Manage Email Rules (Ctrl+R)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Filter24" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rules" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Style="{StaticResource TopToolbarMenuItemStyle}" ToolTip="Change Reading Pane Layout">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="PanelRight24" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Layout ▾" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Header="Reading Pane Right" Command="{Binding SetLayoutCommand}" CommandParameter="Right" Style="{StaticResource TopToolbarSubMenuItemStyle}"/>
                                <MenuItem Header="Reading Pane Bottom" Command="{Binding SetLayoutCommand}" CommandParameter="Bottom" Style="{StaticResource TopToolbarSubMenuItemStyle}"/>
                                <MenuItem Header="Reading Pane Hidden" Command="{Binding SetLayoutCommand}" CommandParameter="Off" Style="{StaticResource TopToolbarSubMenuItemStyle}"/>
                            </MenuItem>
                        </Menu>

                        <ui:Button Style="{StaticResource TopToolbarIconButtonStyle}"
                                   Command="{Binding ToggleReadingPaneDarkModeCommand}"
                                   ToolTip="Toggle Reading Pane Theme">
                            <ui:SymbolIcon Symbol="DarkTheme24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ui:Button>

                        <ui:Button Style="{StaticResource TopToolbarIconButtonStyle}"
                                   Command="{Binding OpenSettingsCommand}"
                                   Margin="0"
                                   ToolTip="Settings (Ctrl+,)">
                            <ui:SymbolIcon Symbol="Settings24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ui:Button>
                    </StackPanel>

                    <!-- Left Actions: General, Folder & Selected Email Actions -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Group 1: General & Folder Actions -->
                        <ui:Button Style="{StaticResource TopToolbarButtonStyle}"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Refresh folders and emails (F5)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl ContentTemplate="{StaticResource RefreshSpinnerTemplate}"
                                                Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="ArrowClockwise24"
                                               Visibility="{Binding IsRefreshing, Converter={StaticResource InverseBoolToVis}}"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Style="{StaticResource TopToolbarButtonStyle}"
                                   Command="{Binding ToggleFolderEditModeCommand}"
                                   ToolTip="Customize Folders (Rename, Reorder, Color, Hide)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Edit24" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Folders" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Style="{StaticResource TopToolbarMenuItemStyle}"
                                      ItemsSource="{Binding Rules}"
                                      ToolTip="Apply a rule to all emails in the current folder">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Filter24" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Apply to Folder ▾" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource TopToolbarSubMenuItemStyle}">
                                        <Setter Property="Command" Value="{Binding DataContext.ApplyRuleToAllCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                        <Setter Property="HeaderTemplate">
                                            <Setter.Value>
                                                <DataTemplate DataType="{x:Type models:FilterRule}">
                                                    <Border Background="{Binding Color, Converter={StaticResource HexColorBrush}}"
                                                            CornerRadius="3"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   TextWrapping="NoWrap"/>
                                                    </Border>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </Menu>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource CardStrokeColorDefaultBrush}" Margin="3,0,6,0" VerticalAlignment="Center"/>

                        <!-- Group 2: Selected Email Actions (Visually distinguished and clearly indicated) -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3,2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding HasSelectedEmail}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Selected Email Badge -->
                                <Border Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        CornerRadius="4"
                                        Padding="5,2"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Mail24" Foreground="White" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Selected" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- New Rule -->
                                <ui:Button Style="{StaticResource TopToolbarButtonStyle}"
                                           Command="{Binding OpenCreateRuleDialogCommand}"
                                           ToolTip="Create new filter rule based on the selected email">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Add24" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="New Rule" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- Mini Divider -->
                                <Rectangle Width="1" Height="18" Fill="{DynamicResource CardStrokeColorDefaultBrush}" Margin="2,0,5,0" VerticalAlignment="Center"/>

                                <!-- Star / Flag -->
                                <ui:Button Style="{StaticResource TopToolbarIconButtonStyle}"
                                           Command="{Binding ToggleStarCommand}"
                                           ToolTip="Toggle star/flag for selected email">
                                    <ui:SymbolIcon Symbol="Star24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ui:Button>

                                <!-- Mark Read -->
                                <ui:Button Style="{StaticResource TopToolbarIconButtonStyle}"
                                           Command="{Binding ToggleReadCommand}"
                                           ToolTip="Toggle read/unread status for selected email">
                                    <ui:SymbolIcon Symbol="MailRead24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ui:Button>

                                <!-- Archive -->
                                <ui:Button Style="{StaticResource TopToolbarIconButtonStyle}"
                                           Command="{Binding ArchiveEmailCommand}"
                                           ToolTip="Move selected email to Archive">
                                    <ui:SymbolIcon Symbol="Archive24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ui:Button>

                                <!-- Delete -->
                                <ui:Button Style="{StaticResource TopToolbarDangerIconButtonStyle}"
                                           Command="{Binding DeleteEmailCommand}"
                                           ToolTip="Move selected email to Deleted Items">
                                    <ui:SymbolIcon Symbol="Delete24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ui:Button>

                                <!-- Open in Web -->
                                <ui:Button Style="{StaticResource TopToolbarIconButtonStyle}"
                                           Command="{Binding OpenInWebCommand}"
                                           Margin="0"
                                           ToolTip="Open selected email in browser">
                                    <ui:SymbolIcon Symbol="Open24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
        </Border>

        <!-- Main Workspace: Sidebar + Email List + Reading Pane -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Folders Sidebar -->
                <ColumnDefinition Width="240" MinWidth="160" MaxWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Email List + Reading Pane Split -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Folders -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Padding="8,6"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Folders"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Folders List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Folders}"
                             SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FolderListItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MailFolderItem}">
                                <Border Margin="{Binding Level, Converter={StaticResource FolderLevelMargin}}">
                                    <Grid Margin="2,3">
                                        <!-- Normal Mode Display -->
                                        <Grid Visibility="{Binding DataContext.IsEditingFolders, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Folder Icon with Custom Color -->
                                            <ui:SymbolIcon Grid.Column="0"
                                                           Symbol="{Binding Converter={StaticResource FolderSymbol}}"
                                                           Foreground="{Binding Color, Converter={StaticResource HexColorBrush}}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>

                                            <!-- Folder Display Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EffectiveDisplayName}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Unread Count Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    CornerRadius="10"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding UnreadItemCount, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding UnreadItemCount}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <!-- Edit Mode Display -->
                                        <Grid Visibility="{Binding DataContext.IsEditingFolders, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- In-place Custom Name Edit -->
                                            <ui:TextBox Grid.Row="0" Grid.Column="0"
                                                        Text="{Binding CustomDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{Binding DisplayName}"
                                                        Margin="0,0,4,4"/>

                                            <!-- Controls: Hide/Show, Move Up/Down -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                <ui:Button Appearance="Transparent"
                                                           Icon="{ui:SymbolIcon Symbol=Eye24}"
                                                           Command="{Binding DataContext.ToggleFolderVisibilityCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Toggle Visibility"
                                                           Margin="0,0,2,0"/>
                                                <ui:Button Appearance="Transparent"
                                                           Icon="{ui:SymbolIcon Symbol=ArrowUp24}"
                                                           Command="{Binding DataContext.MoveFolderUpCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Move Up"
                                                           Margin="0,0,2,0"/>
                                                <ui:Button Appearance="Transparent"
                                                           Icon="{ui:SymbolIcon Symbol=ArrowDown24}"
                                                           Command="{Binding DataContext.MoveFolderDownCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Move Down"/>
                                            </StackPanel>

                                            <!-- Color Swatches Row -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,4">
                                                <TextBlock Text="Color:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Button Width="16" Height="16" Background="#0052CC" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#0052CC"/>
                                                <Button Width="16" Height="16" Background="#2EA44F" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#2EA44F"/>
                                                <Button Width="16" Height="16" Background="#D9534F" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#D9534F"/>
                                                <Button Width="16" Height="16" Background="#F97316" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#F97316"/>
                                                <Button Width="16" Height="16" Background="#8B5CF6" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#8B5CF6"/>
                                                <Button Width="16" Height="16" Background="#06B6D4" BorderThickness="0" Margin="0,0,3,0"
                                                        Click="OnSetFolderColorClick" Tag="#06B6D4"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

            <!-- MAIN CONTENT: Email List + Reading Pane -->
            <Grid Grid.Column="2">
                <!-- Layout 1: Right Reading Pane -->
                <Grid Visibility="{Binding IsReadingPaneRight, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="350"/>
                    </Grid.ColumnDefinitions>

                    <!-- Email List Column -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Email List Header -->
                        <Border Grid.Row="0" Padding="10,6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedFolder.EffectiveDisplayName, FallbackValue='Inbox'}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Emails.Count, StringFormat='({0} emails)'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Search Box -->
                        <Grid Grid.Row="1" Margin="8,6,8,2">
                            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Search emails by subject, sender, or text..."
                                        Icon="{ui:SymbolIcon Symbol=Search24}"
                                        ClearButtonEnabled="True"/>
                        </Grid>

                        <!-- Email Cards List -->
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Emails}"
                                 SelectedItem="{Binding SelectedEmail, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource EmailListItemStyle}"
                                 ItemTemplate="{StaticResource EmailListItemTemplate}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>

                    <!-- Splitter 2 -->
                    <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Right Reading Pane Column -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Padding="14,10">
                        <!-- Details View -->
                        <Grid Visibility="{Binding SelectedEmail, Converter={StaticResource NullToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Email Subject -->
                            <TextBlock Grid.Row="0"
                                       Text="{Binding SelectedEmail.Subject}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <!-- Sender / Meta Row -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Initials Avatar -->
                                    <Border Grid.Column="0" Width="36" Height="36"
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            CornerRadius="18" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding SelectedEmail.From, Converter={StaticResource Initials}}"
                                                   FontWeight="Bold" FontSize="13" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Row 1: Sender Name & Email Address -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding SelectedEmail.From}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SelectedEmail.FromAddress, StringFormat='&lt;{0}&gt;'}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Row 2: Date / Time Received -->
                                        <TextBlock Text="{Binding SelectedEmail.ReceivedDateTime, Converter={StaticResource FriendlyDate}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Email Body Viewer -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6" Padding="0" ClipToBounds="True">
                                <WebBrowser helpers:WebBrowserHelper.Html="{Binding SelectedEmail.DisplayBody}"
                                            helpers:WebBrowserHelper.IsDarkMode="{Binding IsReadingPaneDarkMode}"
                                            Visibility="{Binding IsApplyingRule, Converter={StaticResource InverseBoolToHidden}}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Layout 2: Bottom Reading Pane -->
                <Grid Visibility="{Binding IsReadingPaneBottom, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300" MinHeight="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="200"/>
                    </Grid.RowDefinitions>

                    <!-- Top Email List -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <Grid Grid.Row="0" Margin="8,6,8,2">
                            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Search emails by subject, sender, or text..."
                                        Icon="{ui:SymbolIcon Symbol=Search24}"
                                        ClearButtonEnabled="True"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Emails}"
                                 SelectedItem="{Binding SelectedEmail, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource EmailListItemStyle}"
                                 ItemTemplate="{StaticResource EmailListItemTemplate}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6"/>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Bottom Details -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Padding="14,10">
                        <Grid Visibility="{Binding SelectedEmail, Converter={StaticResource NullToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding SelectedEmail.Subject}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedEmail.From}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedEmail.FromAddress, StringFormat='&lt;{0}&gt;'}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding SelectedEmail.ReceivedDateTime, Converter={StaticResource FriendlyDate}}"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Email Body Viewer -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6" Padding="0" ClipToBounds="True">
                                <WebBrowser helpers:WebBrowserHelper.Html="{Binding SelectedEmail.DisplayBody}"
                                            helpers:WebBrowserHelper.IsDarkMode="{Binding IsReadingPaneDarkMode}"
                                            Visibility="{Binding IsApplyingRule, Converter={StaticResource InverseBoolToHidden}}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Layout 3: Off / Full List Mode -->
                <Grid Visibility="{Binding IsReadingPaneVisible, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Row="0" Margin="8,6,8,2">
                        <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search emails by subject, sender, or text..."
                                    Icon="{ui:SymbolIcon Symbol=Search24}"
                                    ClearButtonEnabled="True"/>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Emails}"
                             SelectedItem="{Binding SelectedEmail, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource EmailListItemStyle}"
                             ItemTemplate="{StaticResource EmailListItemTemplate}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status Bar Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Rule Application Progress Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Background="#80000000"
              Visibility="{Binding IsApplyingRule, Converter={StaticResource BoolToVis}}">
            <Border Width="420"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ApplyingRuleName, StringFormat='Applying Rule: {0}'}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <ProgressBar Value="{Binding RuleProgressPercent}" Height="8" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{Binding RuleProgressCurrent, StringFormat='Processing {0}'}"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding RuleProgressPercent, StringFormat='{}{0}%'}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="{Binding RuleProgressSubject}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,16"/>

                    <ui:Button Content="Cancel" Appearance="Secondary"
                               Command="{Binding CancelApplyRuleCommand}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
