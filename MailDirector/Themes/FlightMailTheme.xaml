<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:models="clr-namespace:MailDirector.Models"
                    xmlns:converters="clr-namespace:MailDirector.Converters">

    <!-- Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True"/>
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToHidden" Inverse="True" UseHidden="True"/>
    <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    <converters:NullToVisibilityConverter x:Key="InverseNullToVis" Inverse="True"/>
    <converters:NullToBoolConverter x:Key="NullToBool"/>
    <converters:FriendlyDateConverter x:Key="FriendlyDate"/>
    <converters:HexColorToBrushConverter x:Key="HexColorBrush"/>
    <converters:StringTruncateConverter x:Key="Truncate"/>
    <converters:InitialsConverter x:Key="Initials"/>
    <converters:FolderLevelToMarginConverter x:Key="FolderLevelMargin"/>
    <converters:FolderSymbolIconConverter x:Key="FolderSymbol"/>
    <converters:SingleLineConverter x:Key="SingleLine"/>
    <converters:ActionTypeToStringConverter x:Key="ActionTypeToString"/>

    <!-- Refresh Spinner Template -->
    <DataTemplate x:Key="RefreshSpinnerTemplate">
        <Viewbox Width="14" Height="14" Stretch="Uniform">
            <Grid Width="20" Height="20">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="RefreshSpinnerRotate" CenterX="10" CenterY="10"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Name="RefreshSpinnerStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="RefreshSpinnerRotate"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0"
                                                 To="360"
                                                 Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="FrameworkElement.Unloaded">
                        <StopStoryboard BeginStoryboardName="RefreshSpinnerStoryboard"/>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse Width="16"
                         Height="16"
                         Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                         StrokeThickness="2.5"
                         StrokeDashArray="3 8"/>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <!-- Top Toolbar Button Style -->
    <Style x:Key="TopToolbarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TopToolbarDangerButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Appearance" Value="Danger"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Top Toolbar Icon-Only Button Style -->
    <Style x:Key="TopToolbarIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TopToolbarDangerIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Appearance" Value="Danger"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Top Toolbar Menu Item Style (Dropdown button look) -->
    <Style x:Key="TopToolbarMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               VerticalOffset="2">
                            <Grid Margin="4" SnapsToDevicePixels="True">
                                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                        CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="2"
                                                          Direction="270"
                                                          Color="#000000"
                                                          Opacity="0.35"/>
                                    </Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        MinWidth="160">
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="5"
                                            Padding="2">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top Toolbar Sub-Menu Item Style -->
    <Style x:Key="TopToolbarSubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="SubBd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="SubBd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SubBd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Folder List Item Style -->
    <Style x:Key="FolderListItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6,4">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Email List Item Style -->
    <Style x:Key="EmailListItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="EmailCard"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="EmailCard" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                            <Setter TargetName="EmailCard" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="EmailCard" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Email List Item Template -->
    <DataTemplate x:Key="EmailListItemTemplate" DataType="{x:Type models:EmailItem}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Unread Indicator Dot -->
            <Ellipse Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="8" Height="8"
                     Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                     Visibility="{Binding IsRead, Converter={StaticResource InverseBoolToVis}}"
                     Margin="0,0,8,0" VerticalAlignment="Center"/>

            <!-- Row 1: Sender Name, Subject & Date -->
            <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sender Name -->
                <TextBlock Grid.Column="0"
                           Text="{Binding From}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Subject -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Subject}"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Date -->
                <TextBlock Grid.Column="2"
                           Text="{Binding ReceivedDateTime, Converter={StaticResource FriendlyDate}}"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 2: Body Preview (Single Line) & Matching Rules Badges -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" VerticalAlignment="Center" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Preview Snippet (Single line, no wrap) -->
                <TextBlock Grid.Column="0"
                           Text="{Binding BodyPreview, Converter={StaticResource SingleLine}}"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Matching Rules Badges -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding MatchingRules}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:MatchingRuleDto}">
                            <Border Background="{Binding Color, Converter={StaticResource HexColorBrush}}"
                                    CornerRadius="3" Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:EmailItem}">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EmailListItemTemplate}"/>
    </DataTemplate>

</ResourceDictionary>
